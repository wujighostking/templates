{
  "name": "tmes",
  "version": "2.0.0",
  "private": true,
  "description": "自用脚手架",
  "keywords": [],
  "license": "MIT",
  "author": "",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "docs:dev": "pnpm exec vitepress dev docs",
    "docs:build": "pnpm exec vitepress build docs",
    "docs:preview": "pnpm exec vitepress preview docs",
    "prepare": "simple-git-hooks",
    "preinstall": "npx only-allow pnpm"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "lint-staged": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "simple-git-hooks": "catalog:",
    "tsdown": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitepress": "^1.6.4"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged",
    "commit-msg": "pnpx commitlint --edit"
  },
  "lint-staged": {
    "*": [
      "pnpm lint:fix",
      "pnpm fmt"
    ]
  },
  "packageManager": "pnpm@10.30.3"
}
